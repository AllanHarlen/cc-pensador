{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://allan.local/cc-pensador/design-contract.schema.json",
  "title": "Resolved Design Contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "systemId", "tokens", "contrastPairs", "components",
    "layouts", "iconography", "imagery", "microcopy", "antiPatterns"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "systemId": { "type": "string", "minLength": 1 },
    "tokens": {
      "type": "object",
      "required": ["colors", "typography", "spacing", "breakpoints", "radius", "borders", "elevation", "motion"],
      "additionalProperties": { "type": "object" },
      "properties": {
        "colors": { "$ref": "#/$defs/tokenFamily" },
        "typography": { "$ref": "#/$defs/tokenFamily" },
        "spacing": { "$ref": "#/$defs/tokenFamily" },
        "breakpoints": { "$ref": "#/$defs/tokenFamily" },
        "radius": { "$ref": "#/$defs/tokenFamily" },
        "borders": { "$ref": "#/$defs/tokenFamily" },
        "elevation": { "$ref": "#/$defs/tokenFamily" },
        "motion": { "$ref": "#/$defs/tokenFamily" }
      }
    },
    "contrastPairs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["foreground", "background", "minimum"],
        "properties": {
          "foreground": { "type": "string" },
          "background": { "type": "string" },
          "minimum": { "type": "number", "minimum": 3 }
        }
      }
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "states"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "states": {
            "type": "array",
            "contains": { "const": "default" },
            "minItems": 1,
            "items": { "type": "string" }
          }
        }
      }
    },
    "layouts": { "type": "array", "minItems": 1 },
    "iconography": {
      "type": "object",
      "required": ["package", "version", "format", "usages"],
      "properties": {
        "package": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "format": { "const": "vector" },
        "usages": { "type": "object", "minProperties": 1 }
      }
    },
    "imagery": {
      "type": "object",
      "required": ["decision", "assets"],
      "properties": {
        "decision": { "enum": ["full-package", "required-only", "external-assets"] },
        "assets": { "type": "array" }
      }
    },
    "microcopy": { "type": "object" },
    "antiPatterns": { "type": "array", "minItems": 1, "items": { "type": "string" } }
  },
  "$defs": {
    "tokenFamily": { "type": "object", "minProperties": 1 }
  }
}
