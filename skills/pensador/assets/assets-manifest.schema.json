{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://allan.local/cc-pensador/assets-manifest.schema.json",
  "title": "Pensador Visual Assets Manifest",
  "type": "object",
  "required": ["schemaVersion", "decision", "assets"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "decision": { "enum": ["full-package", "required-only", "external-assets"] },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "purpose", "classification", "requirementRefs", "routes", "componentSlot", "file", "aspectRatio", "alt", "materializeInto", "seedBindings", "approval", "sha256", "generator"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "purpose": { "enum": ["content", "brand", "seed-demo"] },
          "classification": { "enum": ["required", "recommended"] },
          "requirementRefs": { "type": "array", "items": { "type": "string" } },
          "routes": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "componentSlot": { "type": "string", "minLength": 1 },
          "file": { "type": "string", "pattern": "^(generated|external)/" },
          "aspectRatio": { "type": "string", "pattern": "^[0-9]+:[0-9]+$" },
          "alt": { "type": "string", "minLength": 1 },
          "materializeInto": { "type": "string", "minLength": 1 },
          "seedBindings": { "type": "array", "items": { "type": "string" } },
          "approval": { "const": "approved" },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "generator": {
            "type": "object",
            "required": ["agent", "model", "conversationId"],
            "properties": {
              "agent": { "enum": ["agy", "external"] },
              "model": { "type": "string", "minLength": 1 },
              "conversationId": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    }
  }
}
