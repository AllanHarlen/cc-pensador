{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://cc-pensador/schemas/design-brief.schema.json",
  "title": "Design Brief",
  "description": "Brief de design persistido em <featurePath>/design-brief.json (gerado por buildDesignBrief()). Cada resposta do AskUserQuestion vira um campo { value, locked, questionRef }. locked=true e uma decisao explicita do usuario e prevalece sobre qualquer proposta (briefToSeed nunca a sobrescreve). approvedAt/approvedSha256 sao preenchidos na aprovacao visual do design system.",
  "type": "object",
  "required": [
    "schemaVersion",
    "product",
    "fields",
    "issues",
    "approvedAt",
    "approvedSha256"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "product": {
      "type": "object",
      "required": [
        "name",
        "slug"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "slug": {
          "type": "string"
        }
      }
    },
    "fields": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "colorPrimary": {
          "$ref": "#/definitions/hexField"
        },
        "colorSuccess": {
          "$ref": "#/definitions/hexField"
        },
        "colorWarning": {
          "$ref": "#/definitions/hexField"
        },
        "colorError": {
          "$ref": "#/definitions/hexField"
        },
        "colorInfo": {
          "$ref": "#/definitions/hexField"
        },
        "fontFamily": {
          "$ref": "#/definitions/textField"
        },
        "fontFamilyCode": {
          "$ref": "#/definitions/textField"
        },
        "fontSize": {
          "$ref": "#/definitions/numberField10to24"
        },
        "density": {
          "allOf": [
            {
              "$ref": "#/definitions/enumField"
            },
            {
              "properties": {
                "value": {
                  "enum": [
                    "compact",
                    "comfortable",
                    "spacious"
                  ]
                }
              }
            }
          ]
        },
        "borderRadius": {
          "$ref": "#/definitions/numberField0to32"
        },
        "motion": {
          "allOf": [
            {
              "$ref": "#/definitions/enumField"
            },
            {
              "properties": {
                "value": {
                  "enum": [
                    "none",
                    "subtle",
                    "standard"
                  ]
                }
              }
            }
          ]
        },
        "themeDefault": {
          "allOf": [
            {
              "$ref": "#/definitions/enumField"
            },
            {
              "properties": {
                "value": {
                  "enum": [
                    "light",
                    "dark",
                    "system"
                  ]
                }
              }
            }
          ]
        },
        "themeExposure": {
          "allOf": [
            {
              "$ref": "#/definitions/enumField"
            },
            {
              "properties": {
                "value": {
                  "enum": [
                    "toggle",
                    "system",
                    "light-only"
                  ]
                }
              }
            }
          ]
        },
        "sectorContext": {
          "$ref": "#/definitions/textField"
        },
        "visualTone": {
          "$ref": "#/definitions/textField"
        },
        "brandUrl": {
          "allOf": [
            { "$ref": "#/definitions/field" },
            { "properties": { "value": { "type": "string", "pattern": "^https?://", "maxLength": 2048 } } }
          ]
        },
        "brandReferences": {
          "allOf": [
            {
              "$ref": "#/definitions/field"
            },
            {
              "properties": {
                "value": {
                  "oneOf": [
                    {
                      "type": "string",
                      "minLength": 1
                    },
                    {
                      "type": "array",
                      "minItems": 1,
                      "items": {
                        "type": "string"
                      }
                    }
                  ]
                }
              }
            }
          ]
        },
        "accessibility": {
          "$ref": "#/definitions/textField"
        },
        "microcopy": {
          "$ref": "#/definitions/textField"
        }
      }
    },
    "issues": {
      "type": "array",
      "description": "Respostas descartadas por campo desconhecido ou valor invalido — nunca viram default silencioso.",
      "items": {
        "type": "object",
        "required": [
          "field",
          "reason"
        ],
        "additionalProperties": false,
        "properties": {
          "field": {
            "type": "string"
          },
          "reason": {
            "enum": [
              "unknown-field",
              "invalid-value"
            ]
          }
        }
      }
    },
    "approvedAt": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "approvedSha256": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "definitions": {
    "field": {
      "type": "object",
      "required": [
        "value",
        "locked",
        "questionRef"
      ],
      "additionalProperties": false,
      "properties": {
        "value": {},
        "locked": {
          "type": "boolean"
        },
        "questionRef": {
          "type": [
            "string",
            "null"
          ],
          "description": "Referencia da pergunta de origem (AskUserQuestion)."
        }
      }
    },
    "hexField": {
      "allOf": [
        {
          "$ref": "#/definitions/field"
        },
        {
          "properties": {
            "value": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$"
            }
          }
        }
      ]
    },
    "textField": {
      "allOf": [
        {
          "$ref": "#/definitions/field"
        },
        {
          "properties": {
            "value": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    },
    "enumField": {
      "$ref": "#/definitions/field"
    },
    "numberField10to24": {
      "allOf": [
        {
          "$ref": "#/definitions/field"
        },
        {
          "properties": {
            "value": {
              "type": "number",
              "minimum": 10,
              "maximum": 24
            }
          }
        }
      ]
    },
    "numberField0to32": {
      "allOf": [
        {
          "$ref": "#/definitions/field"
        },
        {
          "properties": {
            "value": {
              "type": "number",
              "minimum": 0,
              "maximum": 32
            }
          }
        }
      ]
    }
  }
}
